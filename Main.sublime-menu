[
{"id":"tools", "children":[
  {"caption": "-", "id": "packagecommands" },
  {"caption": "AutoHotkey", "children":[
    {"caption":"AutoHotkey Default - Run"    ,"command":"ahkrun"                                      },
    {"caption":"AutoHotkey Classic - Run"    ,"command":"ahkrun"     ,"args":{"version":"classic"    }},
    {"caption":"AutoHotkey Lexikos_A32 - Run","command":"ahkrun"     ,"args":{"version":"lexikos_A32"}},
    {"caption":"AutoHotkey Lexikos_U32 - Run","command":"ahkrun"     ,"args":{"version":"lexikos_U32"}},
    {"caption":"AutoHotkey Lexikos_U64 - Run","command":"ahkrun"     ,"args":{"version":"lexikos_U64"}},
    {"caption":"AutoHotkey Default - Compile","command":"ahkcompile"                                  },
    {"caption":"AutoHotkey Classic - Compile","command":"ahkcompile" ,"args":{"version":"classic"    }},
    {"caption":"AutoHotkey Lexikos - Compile","command":"ahkcompile" ,"args":{"version":"lexikos"    }},
    {"caption":"AutoHotkey - Run As Piped Buffer","command":"ahkrunpiped","mnemonic":"P"},
  ]}
]},
{  "id":"preferences"      ,"children":[
  {"id":"package-settings" ,"children":[
    {"caption":"AutoHotkey","children":[
        {"caption": "Settings - Default","command":"open_file","args":{"file":"${packages}/AutoHotkey/AutoHotkey.sublime-settings"}},
        {"caption": "Settings - User"   ,"command":"open_file","args":{"file":"${packages}/User/AutoHotkey.sublime-settings"}}
    ]}
  ]}
]}
]
