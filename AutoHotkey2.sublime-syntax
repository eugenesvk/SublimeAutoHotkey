%YAML 1.2
---
name             : AutoHotkey                          # extends the AutoHotkey package with v2-specific contexts
file_extensions  : [ahk]
first_line_match : '^#Requires AutoHotKey v?2[\d\.\-a-z]*'
scope            : source.ahk
version          : 2
extends          : Packages/SublimeAutoHotkey/AutoHotkey.sublime-syntax

variables:
  escape_chars: '[`;:{nrbtsvaf"'']' # autohotkey.com/docs/v2/misc/EscapeChar.htm

contexts:
  string:
    - include: string-quoted-double
    - include: string-quoted-single

  string-quoted-double:
    - match: (")
      captures:
        1: punctuation.definition.string.begin.ahk
      push:
        - meta_scope: string.quoted.double.ahk
        - match: (`)({{escape_chars}})
          captures:
            1: constant.character.escape.ahk
            2: constant.character.escape.ahk
        - match: (")(?!")|^
          captures:
            1: punctuation.definition.string.end.ahk
          pop: true
        - match: '""'
          scope: constant.character.escape.ahk

  string-quoted-single:
    - match: (')
      captures:
        1: punctuation.definition.string.begin.ahk
      push:
        - meta_scope: string.quoted.single.ahk
        - match: (`)({{escape_chars}})
          captures:
            1: constant.character.escape.ahk
            2: constant.character.escape.ahk
        - match: (')(?!')|^
          captures:
            1: punctuation.definition.string.end.ahk
          pop: true
